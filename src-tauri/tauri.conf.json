{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aios",
  "version": "0.1.0",
  "identifier": "aios.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "sidebar",
        "title": "Aios",
        "x": 0,
        "y": 24,
        "width": 420,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "canvas",
        "title": "Aios Evidence",
        "x": 440,
        "y": 48,
        "width": 860,
        "height": 700,
        "minWidth": 600,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "assets/32x32.png",
      "assets/128x128.png",
      "assets/128x128@2x.png"
    ]
  }
}